# =============================================================================
# RawBlock frontend — Vercel environment variables
# Copy these into your Vercel project: Settings → Environment Variables
# Scope: Production + Preview (and Development if you use `vercel env pull`)
# =============================================================================

# --- Required: live API (Go backend — no change needed on backend) ---
NEXT_PUBLIC_API_URL=https://apigoland.rawblock.net

# --- Required: PostHog behavioral analytics (frontend only) ---
# Create project: https://us.posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_rawblock_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Recommended ---
NEXT_PUBLIC_SITE_URL=https://www.rawblock.net
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Optional: Vercel Web Analytics (@vercel/analytics in layout.tsx) ---
# Set to 1 if you want Vercel Analytics on this deployment (separate from PostHog)
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=0

# =============================================================================
# Server-only (only if you use Next.js /api/proxy-rpc on Vercel — usually NOT needed
# when NEXT_PUBLIC_API_URL points to apigoland.rawblock.net)
# =============================================================================
# BITCOIN_RPC_USER=
# BITCOIN_RPC_PASSWORD=
# BITCOIN_RPC_HOST=
# BITCOIN_RPC_PORT=8332
